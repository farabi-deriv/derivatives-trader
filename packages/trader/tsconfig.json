{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "paths": {
            "_common/*": ["src/_common/*"],
            "AppV2/*": ["src/AppV2/*"],
            "Assets/*": ["src/Assets/*"],
            "Constants/*": ["src/Constants/*"],
            "Modules/*": ["src/Modules/*"],
            "Sass/*": ["src/sass/*"],
            "Services/*": ["src/Services/*"],
            "Stores/*": ["src/Stores/*"],
            "Types": ["src/Types"],
            "Utils/*": ["src/Utils/*"],
            "@deriv/*": ["../*/src"]
        },
        "useDefineForClassFields": true,
        "outDir": "./dist",
        "baseUrl": "./"
    },
    "include": ["src", "../../types/deriv-com-translations.d.ts", "../../types/testing-library.d.ts"]
}
